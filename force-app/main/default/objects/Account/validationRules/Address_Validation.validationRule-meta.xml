<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Address_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>OR(ISBLANK( ShippingStreet ),ISBLANK( ShippingCity ),ISBLANK( ShippingCountry ))</errorConditionFormula>
    <errorDisplayField>ShippingStreet</errorDisplayField>
    <errorMessage>Enter the valid address</errorMessage>
</ValidationRule>
