<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Numeric</fullName>
    <active>false</active>
    <errorConditionFormula>ISBLANK(AccountNumber)||
NOT( ISNUMBER(AccountNumber))</errorConditionFormula>
    <errorDisplayField>AccountNumber</errorDisplayField>
    <errorMessage>Enter the numeric character</errorMessage>
</ValidationRule>
