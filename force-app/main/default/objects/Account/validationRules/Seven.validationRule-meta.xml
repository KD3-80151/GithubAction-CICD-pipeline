<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Seven</fullName>
    <active>false</active>
    <errorConditionFormula>ISBLANK(AccountNumber) || LEN(AccountNumber) &lt;&gt; 7</errorConditionFormula>
    <errorDisplayField>AccountNumber</errorDisplayField>
    <errorMessage>Enter the valid data</errorMessage>
</ValidationRule>
